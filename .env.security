# TorWAR Security Configuration
# Copy to .env and customize for your environment

# === REQUIRED SECURITY SETTINGS ===
SECRET_KEY=your-super-secret-key-here-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this-in-production

# === AUTHENTICATION SETTINGS ===
JWT_EXPIRY_HOURS=24                    # JWT token expiry (hours)
SESSION_TIMEOUT=3600                   # Session timeout (seconds)

# === RATE LIMITING SETTINGS ===
RATE_LIMIT_GLOBAL=100                  # Global requests per hour per IP
RATE_LIMIT_AUTH=10                     # Auth requests per hour per IP
RATE_LIMIT_API=60                      # API requests per hour per IP

# === SECURITY THRESHOLDS ===
FAILED_LOGIN_THRESHOLD=10              # Failed attempts before IP block
IP_BLOCK_DURATION=300                  # IP block duration (seconds)
SUSPICIOUS_REQUEST_THRESHOLD=100       # Requests per minute before flagging

# === HTTPS SETTINGS ===
HTTPS_ENABLED=false                    # Set to true in production
FORCE_HTTPS=false                      # Redirect HTTP to HTTPS
SECURE_COOKIES=false                   # Set to true with HTTPS

# === CSRF SETTINGS ===
CSRF_TIME_LIMIT=3600                   # CSRF token validity (seconds)
CSRF_EXEMPT_ENDPOINTS=                 # Comma-separated list of exempt endpoints

# === CONTENT SECURITY POLICY ===
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' cdn.jsdelivr.net cdnjs.cloudflare.com
CSP_STYLE_SRC='self' 'unsafe-inline' cdn.jsdelivr.net
CSP_IMG_SRC='self' data:

# === LOGGING SETTINGS ===
SECURITY_LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR
SECURITY_LOG_FILE=logs/security.log
AUTH_LOG_FILE=logs/auth.log

# === REDIS SETTINGS (for rate limiting) ===
REDIS_URL=redis://localhost:6379/0

# === DEVELOPMENT SETTINGS ===
DEBUG_SECURITY=false                   # Enable security debug logging
DISABLE_CSRF_IN_DEV=false             # Disable CSRF for development (NOT recommended)
